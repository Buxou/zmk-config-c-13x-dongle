#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "C-13X Layout";
        transform = <&default_transform>;

        keys {
            compatible = "zmk,physical-layout-keys";
            
            bindings = <
                <&key_physical 0 0 0 0> <&key_physical 0 1 0 0> <&key_physical 0 2 0 0> <&key_physical 0 3 0 0> <&key_physical 0 4 0 0> <&key_physical 0 5 0 0> <&key_physical 0 6 0 0> <&key_physical 0 7 0 0> <&key_physical 0 8 0 0> <&key_physical 0 9 0 0>
                <&key_physical 1 0 0 0> <&key_physical 1 1 0 0> <&key_physical 1 2 0 0> <&key_physical 1 3 0 0> <&key_physical 1 4 0 0> <&key_physical 1 5 0 0> <&key_physical 1 6 0 0> <&key_physical 1 7 0 0>                         <&key_physical 1 9 0 0>
                <&key_physical 2 0 0 0> <&key_physical 2 1 0 0> <&key_physical 2 2 0 0> <&key_physical 2 3 0 0> <&key_physical 2 4 0 0> <&key_physical 2 5 0 0> <&key_physical 2 6 0 0> <&key_physical 2 7 0 0> <&key_physical 2 8 0 0> <&key_physical 2 9 0 0>
                <&key_physical 3 0 0 0> <&key_physical 3 1 0 0>                         <&key_physical 3 3 0 0>                         <&key_physical 3 5 0 0>                         <&key_physical 3 7 0 0>                         <&key_physical 3 9 0 0>
            >;
        };
    };
};


&lt { quick-tap-ms = <200>; };

// ... далее весь ваш остальной код keymap (combos, слои MAIN, SYM, NUM, ADJ и т.д.) без изменений ...


&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        apostrophe {
            bindings = <&kp SQT>;
            key-positions = <18 33>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <32 33>;
        };

        win {
            bindings = <&kp LEFT_GUI>;
            key-positions = <27 28>;
        };

        language {
            bindings = <&kp LS(LEFT_ALT)>;
            key-positions = <34 32>;
            require-prior-idle-ms = <165>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt RIGHT_BRACKET Q  &kp W      &kp E  &kp R             &kp T  &kp Y          &kp U  &kp I            &kp O    &mt LEFT_BRACKET P
&kp A                &kp S      &kp D  &kp F             &kp G  &kp H          &kp J  &kp K                     &mt SEMICOLON L
&kp Z                &kp X      &kp C  &kp V             &kp B  &lt 4 N        &kp M  &kp COMMA        &kp DOT  &mt BACKSLASH SLASH
&kp LCTRL            &lt 2 ESC         &mt LSHIFT SPACE         &mt TAB ENTER         &lt 1 BACKSPACE           &kp LALT
            >;

            label = "MAIN";
        };

        lower_layer {
            bindings = <
&mt F12 F1       &kp F2       &kp F3    &kp F4      &kp F5       &kp F6     &kp F7         &kp F8        &kp F9  &mt F11 F10
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK          &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS
&kp N1           &kp N2       &kp N3    &kp N4      &kp N5       &kp N6     &kp N7         &kp N8        &kp N9  &kp N0
&trans           &trans                 &trans                   &trans                    &trans                &trans
            >;

            label = "SYM";
        };

        raise_layer {
            bindings = <
&mt KP_NUMLOCK KP_SLASH   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS  &kp C_VOLUME_UP    &kp HOME      &kp PRINTSCREEN  &kp PG_UP      &mt CAPS SCROLLLOCK
&kp KP_MULTIPLY           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &kp LEFT           &kp UP_ARROW  &kp RIGHT_ARROW                 &kp INSERT
&mt KP_EQUAL KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &kp C_VOLUME_DOWN  &kp END       &kp DOWN_ARROW   &kp PAGE_DOWN  &kp PAUSE_BREAK
&trans                    &trans                            &trans                         &trans                           &trans                          &trans
            >;

            label = "NUM";
        };

        adjust_layer {
            bindings = <
&sys_reset    &bootloader   &ext_power EP_TOG  &studio_unlock  &trans          &trans    &trans        &trans     &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3    &bt BT_SEL 4    &kp LEFT  &kp UP_ARROW  &kp RIGHT          &trans
&trans        &trans        &trans             &bt BT_CLR      &bt BT_CLR_ALL  &trans    &trans        &kp DOWN   &trans  &kp UNDERSCORE
&trans        &trans                           &trans                          &trans                  &trans             &trans
            >;

            label = "ADJ";
        };

        adjust_layer_2 {
            bindings = <
&trans     &kp UP           &trans     &trans  &kp C_VOLUME_UP    &kp PRINTSCREEN  &kp UP_ARROW    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
&kp LEFT   &kp DOWN         &kp RIGHT  &trans  &kp C_MUTE         &kp LEFT         &kp DOWN_ARROW  &kp RIGHT                     &trans
&kp LG(R)  &kp LC(LS(ESC))  &trans     &trans  &kp C_VOLUME_DOWN  &trans           &trans          &trans      &trans            &kp UNDERSCORE
&trans     &trans                      &trans                     &trans                           &trans                        &trans
            >;

            label = "ADJ_2";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        adjust2 {
            if-layers = <4>;
            then-layer = <4>;
        };
    };
};
