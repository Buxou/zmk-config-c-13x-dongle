#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        // Изменили ссылку на c13x_layout, чтобы исправить ошибку undefined node label
        zmk,physical-layout = &c13x_layout;
    };

    c13x_layout: c13x_layout {
        compatible = "zmk,physical-layout";
        display-name = "C-13X";
        transform = <&default_transform>;

        keys {
            compatible = "zmk,physical-layout-keys";

            // Ряд 1 (0) - 10 клавиш. Координаты x/y в условных единицах (шаг 100)
            k00 { matrix-position = <0 0>; x = <0>;   y = <0>; };
            k01 { matrix-position = <0 1>; x = <100>; y = <0>; };
            k02 { matrix-position = <0 2>; x = <200>; y = <0>; };
            k03 { matrix-position = <0 3>; x = <300>; y = <0>; };
            k04 { matrix-position = <0 4>; x = <400>; y = <0>; };
            k05 { matrix-position = <0 5>; x = <500>; y = <0>; };
            k06 { matrix-position = <0 6>; x = <600>; y = <0>; };
            k07 { matrix-position = <0 7>; x = <700>; y = <0>; };
            k08 { matrix-position = <0 8>; x = <800>; y = <0>; };
            k09 { matrix-position = <0 9>; x = <900>; y = <0>; };

            // Ряд 2 (1) - 9 клавиш
            k10 { matrix-position = <1 0>; x = <0>;   y = <100>; };
            k11 { matrix-position = <1 1>; x = <100>; y = <100>; };
            k12 { matrix-position = <1 2>; x = <200>; y = <100>; };
            k13 { matrix-position = <1 3>; x = <300>; y = <100>; };
            k14 { matrix-position = <1 4>; x = <400>; y = <100>; };
            k15 { matrix-position = <1 5>; x = <500>; y = <100>; };
            k16 { matrix-position = <1 6>; x = <600>; y = <100>; };
            k17 { matrix-position = <1 7>; x = <700>; y = <100>; };
            k19 { matrix-position = <1 9>; x = <900>; y = <100>; };

            // Ряд 3 (2) - 10 клавиш
            k20 { matrix-position = <2 0>; x = <0>;   y = <200>; };
            k21 { matrix-position = <2 1>; x = <100>; y = <200>; };
            k22 { matrix-position = <2 2>; x = <200>; y = <200>; };
            k23 { matrix-position = <2 3>; x = <300>; y = <200>; };
            k24 { matrix-position = <2 4>; x = <400>; y = <200>; };
            k25 { matrix-position = <2 5>; x = <500>; y = <200>; };
            k26 { matrix-position = <2 6>; x = <600>; y = <200>; };
            k27 { matrix-position = <2 7>; x = <700>; y = <200>; };
            k28 { matrix-position = <2 8>; x = <800>; y = <200>; };
            k29 { matrix-position = <2 9>; x = <900>; y = <200>; };

            // Ряд 4 (3) - 6 клавиш модификаторов/пробелов
            k30 { matrix-position = <3 0>; x = <0>;   y = <300>; };
            k31 { matrix-position = <3 1>; x = <100>; y = <300>; };
            k33 { matrix-position = <3 3>; x = <300>; y = <300>; };
            k35 { matrix-position = <3 5>; x = <500>; y = <300>; };
            k37 { matrix-position = <3 7>; x = <700>; y = <300>; };
            k39 { matrix-position = <3 9>; x = <900>; y = <300>; };
        };
    };
};

&lt { quick-tap-ms = <200>; };
// ... далее весь ваш остальной код keymap без изменений ...




// ... далее весь ваш остальной код keymap (combos, слои MAIN, SYM, NUM, ADJ и т.д.) без изменений ...


&mt {
    quick-tap-ms = <200>;
    tapping-term-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        apostrophe {
            bindings = <&kp SQT>;
            key-positions = <18 33>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <32 33>;
        };

        win {
            bindings = <&kp LEFT_GUI>;
            key-positions = <27 28>;
        };

        language {
            bindings = <&kp LS(LEFT_ALT)>;
            key-positions = <34 32>;
            require-prior-idle-ms = <165>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt RIGHT_BRACKET Q  &kp W      &kp E  &kp R             &kp T  &kp Y          &kp U  &kp I            &kp O    &mt LEFT_BRACKET P
&kp A                &kp S      &kp D  &kp F             &kp G  &kp H          &kp J  &kp K                     &mt SEMICOLON L
&kp Z                &kp X      &kp C  &kp V             &kp B  &lt 4 N        &kp M  &kp COMMA        &kp DOT  &mt BACKSLASH SLASH
&kp LCTRL            &lt 2 ESC         &mt LSHIFT SPACE         &mt TAB ENTER         &lt 1 BACKSPACE           &kp LALT
            >;

            label = "MAIN";
        };

        lower_layer {
            bindings = <
&mt F12 F1       &kp F2       &kp F3    &kp F4      &kp F5       &kp F6     &kp F7         &kp F8        &kp F9  &mt F11 F10
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK          &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS
&kp N1           &kp N2       &kp N3    &kp N4      &kp N5       &kp N6     &kp N7         &kp N8        &kp N9  &kp N0
&trans           &trans                 &trans                   &trans                    &trans                &trans
            >;

            label = "SYM";
        };

        raise_layer {
            bindings = <
&mt KP_NUMLOCK KP_SLASH   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS  &kp C_VOLUME_UP    &kp HOME      &kp PRINTSCREEN  &kp PG_UP      &mt CAPS SCROLLLOCK
&kp KP_MULTIPLY           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &kp LEFT           &kp UP_ARROW  &kp RIGHT_ARROW                 &kp INSERT
&mt KP_EQUAL KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &kp C_VOLUME_DOWN  &kp END       &kp DOWN_ARROW   &kp PAGE_DOWN  &kp PAUSE_BREAK
&trans                    &trans                            &trans                         &trans                           &trans                          &trans
            >;

            label = "NUM";
        };

        adjust_layer {
            bindings = <
&sys_reset    &bootloader   &ext_power EP_TOG  &studio_unlock  &trans          &trans    &trans        &trans     &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3    &bt BT_SEL 4    &kp LEFT  &kp UP_ARROW  &kp RIGHT          &trans
&trans        &trans        &trans             &bt BT_CLR      &bt BT_CLR_ALL  &trans    &trans        &kp DOWN   &trans  &kp UNDERSCORE
&trans        &trans                           &trans                          &trans                  &trans             &trans
            >;

            label = "ADJ";
        };

        adjust_layer_2 {
            bindings = <
&trans     &kp UP           &trans     &trans  &kp C_VOLUME_UP    &kp PRINTSCREEN  &kp UP_ARROW    &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT
&kp LEFT   &kp DOWN         &kp RIGHT  &trans  &kp C_MUTE         &kp LEFT         &kp DOWN_ARROW  &kp RIGHT                     &trans
&kp LG(R)  &kp LC(LS(ESC))  &trans     &trans  &kp C_VOLUME_DOWN  &trans           &trans          &trans      &trans            &kp UNDERSCORE
&trans     &trans                      &trans                     &trans                           &trans                        &trans
            >;

            label = "ADJ_2";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        adjust2 {
            if-layers = <4>;
            then-layer = <4>;
        };
    };
};
